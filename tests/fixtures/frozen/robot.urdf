<?xml version="1.0"?>
<robot name="frozen">
  <link name="drivetrain">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drivetrain.glb"/></geometry>
    </visual>
  </link>
  <link name="ascope_origin">
  </link>
  <link name="intake">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/intake.glb"/></geometry>
    </visual>
  </link>
  <link name="flap">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/flap.glb"/></geometry>
    </visual>
  </link>
  <joint name="ascope_origin_frame" type="fixed">
    <parent link="drivetrain"/>
    <child link="ascope_origin"/>
    <origin xyz="0.05 -0.02 -0.1" rpy="0 0 1.5708"/>
  </joint>
  <joint name="j_intake" type="revolute">
    <parent link="drivetrain"/>
    <child link="intake"/>
    <origin xyz="0.35 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.6" effort="0" velocity="0"/>
  </joint>
  <joint name="Revolute 7" type="revolute">
    <parent link="drivetrain"/>
    <child link="flap"/>
    <origin xyz="-0.3 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1" effort="0" velocity="0"/>
  </joint>
</robot>
