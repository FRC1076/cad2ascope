<?xml version="1.0"?>
<robot name="missing_origin">
  <link name="drivetrain">
    <visual>
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drivetrain.glb"/></geometry>
    </visual>
  </link>
  <link name="arm">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/arm.glb"/></geometry>
    </visual>
  </link>
  <joint name="j_arm" type="revolute">
    <parent link="drivetrain"/>
    <child link="arm"/>
    <origin xyz="0.2 0.0 0.5" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>
</robot>
