<?xml version="1.0"?>
<robot name="single_revolute">
  <link name="drivetrain">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drivetrain.glb"/></geometry>
    </visual>
  </link>
  <link name="ascope_origin">
  </link>
  <link name="arm">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/arm.glb"/></geometry>
    </visual>
  </link>
  <joint name="ascope_origin_frame" type="fixed">
    <parent link="drivetrain"/>
    <child link="ascope_origin"/>
    <origin xyz="0.05 -0.02 -0.1" rpy="0 0 1.5708"/>
  </joint>
  <joint name="j_arm" type="revolute">
    <parent link="drivetrain"/>
    <child link="arm"/>
    <origin xyz="0.2 0.1 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1" upper="2" effort="0" velocity="0"/>
  </joint>
</robot>
